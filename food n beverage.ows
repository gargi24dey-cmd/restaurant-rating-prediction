		<properties node_id="17" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02/\x00\x00\x00\xb9\x00\x00\x05Q\x00\x00\x030\x00\x00\x020\x00\x00\x00\xd8\x00\x00\x05P\x00\x00\x03/\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x020\x00\x00\x00\xd8\x00\x00\x05P\x00\x00\x03/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'from Orange.data.pandas_compat import table_to_frame, table_from_frame\n\nif in_data is None:\n    out_data = None\nelse:\n    df = table_to_frame(in_data, include_metas=True)\n\n    print("Raw row count:", len(df))\n\n    # Clean rating\n    def clean_rating(v):\n        try:\n            v = str(v).strip()\n            if v in (\'NA\', \'nan\', \'None\', \'\'):\n                return None\n            return float(v)\n        except Exception:\n            return None\n\n    df[\'rating_clean\'] = df[\'Rating\'].apply(clean_rating)\n    df = df.dropna(subset=[\'rating_clean\'])\n\n    # Clean cost\n    def clean_cost(v):\n        try:\n            v = str(v).replace(\',\', \'\').strip()\n            if v in (\'nan\', \'None\', \'\'):\n                return None\n            return float(v)\n        except Exception:\n            return None\n\n    cost_col = \'Cost for Two (in Rupees)\'\n    df[\'cost_clean\'] = df[cost_col].apply(clean_cost)\n    df = df.dropna(subset=[\'cost_clean\'])\n\n    # Simplify Category: keep only the FIRST cuisine tag listed\n    # (raw Category has many comma-separated tags per row, which isn\'t usable as a clean categorical feature)\n    df[\'Category\'] = df[\'Category\'].astype(str).apply(lambda x: x.split(\',\')[0].strip())\n\n    # Force Category and Area into proper categorical FEATURES, not Metas\n    df[\'Category\'] = df[\'Category\'].astype(\'category\')\n    df[\'Area\'] = df[\'Area\'].astype(\'category\')\n\n    # Target\n    def bin_rating(r):\n        if r &lt; 3.5:\n            return \'Low\'\n        elif r &lt;= 4.0:\n            return \'Medium\'\n        else:\n            return \'High\'\n\n    df[\'rating_class\'] = df[\'rating_clean\'].apply(bin_rating)\n    df[\'rating_class\'] = df[\'rating_class\'].astype(\'category\')\n\n    print("Rows after cleaning:", len(df))\n    print("Rating class counts:")\n    print(df[\'rating_class\'].value_counts())\n    print("Unique Category values (top 10):")\n    print(df[\'Category\'].value_counts().head(10))\n\n    out_data = table_from_frame(df)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
