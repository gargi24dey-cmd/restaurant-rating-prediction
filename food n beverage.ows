		<properties node_id="1" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02/\x00\x00\x00\xb9\x00\x00\x05Q\x00\x00\x030\x00\x00\x020\x00\x00\x00\xd8\x00\x00\x05P\x00\x00\x03/\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x020\x00\x00\x00\xd8\x00\x00\x05P\x00\x00\x03/', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'from Orange.data.pandas_compat import table_to_frame, table_from_frame\nimport pandas as pd\nimport numpy as np\n\nif in_data is None:\n    out_data = None\nelse:\n    df = table_to_frame(in_data, include_metas=True)\n\n    print("COLUMNS:", list(df.columns))\n\n    # 1. Drop heavy/unneeded columns if present\n    drop_cols = [\'url\', \'address\', \'phone\', \'reviews_list\', \'menu_item\',\n                 \'dish_liked\', \'listed_in(city)\']\n    df = df.drop(columns=[c for c in drop_cols if c in df.columns])\n\n    # 2. Clean \'rate\'\n    def clean_rate(val):\n        try:\n            val = str(val).strip()\n            if val in (\'NEW\', \'-\', \'nan\', \'None\', \'\'):\n                return None\n            return float(val.split(\'/\')[0])\n        except Exception:\n            return None\n\n    df[\'rate_clean\'] = df[\'rate\'].apply(clean_rate)\n\n    # 3. Find and clean cost column\n    cost_col = None\n    for c in df.columns:\n        if \'approx_cost\' in c:\n            cost_col = c\n            break\n\n    def clean_cost(val):\n        try:\n            val = str(val).replace(\',\', \'\').strip()\n            if val in (\'nan\', \'None\', \'\'):\n                return None\n            return float(val)\n        except Exception:\n            return None\n\n    if cost_col:\n        df[\'cost_clean\'] = df[cost_col].apply(clean_cost)\n    else:\n        df[\'cost_clean\'] = None\n\n    df = df.dropna(subset=[\'rate_clean\', \'cost_clean\'])\n\n    def bin_rating(r):\n        if r &lt; 3.5:\n            return \'Low\'\n        elif r &lt;= 4.0:\n            return \'Medium\'\n        else:\n            return \'High\'\n\n    df[\'rating_class\'] = df[\'rate_clean\'].apply(bin_rating)\n\n    print("Final row count:", len(df))\n    print("cost_col detected as:", cost_col)\n    df[\'Platform\'] = \'Zomato\'\n    out_data = table_from_frame(df)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
